# ==================================================
# CS2 市场爬虫系统 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ==================================================

# ----- AI 服务配置 (硅基流动) -----
# 用于 AI 投资分析功能，获取地址: https://siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-api-key-here

# ----- SteamDT API 配置 -----
# 从 SteamDT 网站抓包获取
STEAMDT_ACCESS_TOKEN=your-access-token-here
STEAMDT_DEVICE_ID=your-device-id-here

# ----- MongoDB 配置 -----
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=csgo_market
# 如需认证，填写以下配置
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ----- Redis 配置 -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----- API 服务配置 -----
API_HOST=0.0.0.0
API_PORT=8008

# ----- Web 服务配置 -----
WEB_PORT=3000

# ----- 日志配置 -----
LOG_LEVEL=INFO

