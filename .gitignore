# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs - 忽略日志文件但保留目录
logs/*.log
api/logs/*.log
!logs/.gitkeep
!api/logs/.gitkeep

# Data - 忽略大型数据文件和图片
data/crawl_progress.json
data/api_requests.json
data/images/
!data/images/.gitkeep
*.csv
*.db

# Images - 忽略爬取的图片
*.jpg
*.jpeg
*.png
*.gif
!web/*.png
!web/*.gif

# ML Models
ml/models/*.pkl
ml/models/*.joblib
data/models/*.pkl
data/models/*.joblib

# Scrapy
.scrapy/
httpcache/
crawls/

# MongoDB
*.bson

# Redis
dump.rdb
appendonly.aof

# OS
.DS_Store
Thumbs.db

# ===== 敏感配置文件 =====
# 包含 API 密钥等敏感信息，绝不提交
.env

# Temporary files
*.tmp
*.temp

